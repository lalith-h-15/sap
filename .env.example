NODE_ENV=development
PORT=5100
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set this to the SAME signing secret used by AcademiaConnect if you want its JWTs accepted.
# If omitted, protected routes reject requests. Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=academiaconnect
JWT_AUDIENCE=career-orchestrator
# Optional upstream AcademiaConnect API. Leave blank to use seeded local employee context.
ACADEMIA_API_BASE_URL=
ACADEMIA_SERVICE_TOKEN=
# Optional future AI provider. Deterministic agents work without it.
AI_PROVIDER=rules
SAP_GENAI_ENDPOINT=
SAP_GENAI_API_KEY=
